{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryubreed-subscription-api",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "ryubreedacedemia",
    "ADMIN_ID": "r8gGkQN9nbWcLjIdSJV7zuYYEFC2",
    "ADMIN_UID": "r8gGkQN9nbWcLjIdSJV7zuYYEFC2",
    "ADMIN_BOOTSTRAP_UID": "r8gGkQN9nbWcLjIdSJV7zuYYEFC2",
    "ADMIN_DASHBOARD_URL": "http://localhost:3000",
    "ALLOWED_ORIGINS": "https://ryubreedacedemia.web.app,https://ryubreedacedemia.firebaseapp.com,https://academia.ryubreed.com,https://admin.ryubreed.com,http://localhost:3000",
    "ENABLE_PAYMENT_ACTIVATION": "false"
  }
}

